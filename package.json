{
  "name": "product-template",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"cd server && npm run dev\" \"cd client && npm run dev\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "prebuild": "node scripts/prebuild.js",
    "build": "cd client && npm run build",
    "start": "sh start.sh",
    "lint": "cd client && npm run lint",
    "typecheck": "cd client && npm run typecheck && cd ../server && npm run typecheck",
    "test": "npm run test:client && npm run test:server",
    "test:client": "cd client && npm test",
    "test:server": "cd server && npm test -- --forceExit",
    "test:unit": "cd server && npm test -- --testPathPattern=test/unit",
    "test:api": "cd server && npm test -- --testPathPattern=test/api",
    "test:coverage": "cd client && npm run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:all": "PLAYWRIGHT_ALL_BROWSERS=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e",
    "docs:check": "node scripts/check-doc-links.mjs",
    "docker:build": "docker build -t product-template:local .",
    "docker:smoke": "bash scripts/ci/docker-smoke.sh product-template:local",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db-local": "bash scripts/@system/dev/run-db-local.sh",
    "docker-local": "bash scripts/@system/dev/run-docker-local.sh",
    "bootstrap": "node scripts/@system/dev/bootstrap.js",
    "bootstrap:force": "node scripts/@system/dev/bootstrap.js --force",
    "bootstrap-env": "bash scripts/@system/dev/bootstrap-env.sh",
    "bootstrap-env:force": "bash scripts/@system/dev/bootstrap-env.sh --force",
    "generate-keys": "node scripts/@system/dev/generate-keys.js",
    "generate-barrels": "node scripts/@system/generate-barrels.js",
    "set-customs": "bash scripts/@system/dev/set-customs.sh",
    "first-setup": "npm i && npm run bootstrap && npm run set-customs && npm run db-local",
    "apply-brand": "node scripts/apply-brand.js",
    "brand:generate": "node scripts/generate-brand-assets.js",
    "brand:og": "node scripts/generate-og-thumbnails.js",
    "brand:ensure-logo": "node scripts/ensure-transparent-logo.js",
    "generate:brand-assets": "node scripts/generate-brand-assets.js",
    "generate:favicons": "node scripts/generate-brand-assets.js",
    "generate-assets": "node scripts/generate-brand-assets.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "dependencies": {}
}
