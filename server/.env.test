# ── Test environment defaults ─────────────────────────────────────────────────
# Copy to server/.env (or export these vars) for running tests locally.
# Crypto keys (JWT keypair, ENCRYPT_KEY/IV) must be generated first:
#   npm run bootstrap   (from project root)
#
# This file is safe to commit — it contains no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=4001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_template_test
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_CONNECTION_TIMEOUT=2000
DB_POOL_SSL=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth — generate with: npm run bootstrap ───────────────────────────────────
# JWT_PRIVATE_KEY_FILE and JWT_PUBLIC_KEY are populated by bootstrap.
# Leave blank here; bootstrap writes them into server/.env.
JWT_PRIVATE_KEY_FILE=.keys/jwt_private.pem
JWT_PUBLIC_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
APP_NAME=product-template-test
SERVER_URL=http://localhost:4001

# ── Email — console only in test ──────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=test@example.com

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=error
SERVICE_NAME=server-test
