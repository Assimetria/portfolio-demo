{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node src/db/migrations/@system/run.js",
    "migrate:status": "node src/db/migrations/@system/run.js --status",
    "migrate:dry": "node src/db/migrations/@system/run.js --dry-run",
    "migrate:rollback": "node src/db/migrations/@system/run.js --rollback",
    "migrate:create": "node src/db/migrations/create.js",
    "seed": "node src/db/seed.js",
    "seed:clean": "node src/db/seed.js --clean",
    "test": "jest --ci --forceExit --testPathIgnorePatterns=integration --testPathIgnorePatterns=smoke",
    "test:unit": "jest --ci --forceExit test/unit",
    "test:api": "jest --ci --forceExit test/api",
    "test:integration": "jest --ci --forceExit --testPathPattern=integration",
    "test:smoke": "jest --ci --forceExit --testPathPattern=smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.998.0",
    "@aws-sdk/client-ses": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.998.0",
    "@graphql-tools/schema": "^10.0.31",
    "@sentry/node": "^8.55.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.20.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "graphql": "^16.13.1",
    "graphql-http": "^1.22.4",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.7",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.1",
    "otpauth": "^9.5.0",
    "pg-promise": "^11.9.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.1",
    "stripe": "^16.6.0",
    "uuid": "^10.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "algoliasearch": "^4.24.0",
    "creatomate": "^1.2.1",
    "ethers": "^6.13.0",
    "facebook-nodejs-business-sdk": "^23.0.2",
    "geoip-lite": "^1.4.10",
    "google-ads-api": "^17.1.0",
    "meilisearch": "^0.44.0",
    "replicate": "^1.0.1",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.5",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3"
  }
}
