{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.mjs",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.mjs",
    "postbuild": "node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build:analyze": "cross-env NODE_ENV=production ANALYZE=true webpack --config webpack.config.mjs",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=2",
    "test:watch": "jest --watch --maxWorkers=2",
    "test:coverage": "jest --coverage --maxWorkers=2"
  },
  "dependencies": {
